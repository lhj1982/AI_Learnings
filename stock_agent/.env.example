# =============================================================================
# LLM API Configuration
# =============================================================================

# Option 1: Use standard OpenAI API
OPENAI_API_KEY=your-openai-api-key-here

# Option 2: Use Cosmos LLM API (OpenAI-compatible)
# Uncomment the lines below and comment out OPENAI_API_KEY above
# LLM_API_KEY=your-cosmos-api-key-here
# LLM_BASE_URL=https://your-cosmos-endpoint.com/v1

# =============================================================================
# Database Configuration (Postgres)
# =============================================================================

DB_HOST=localhost
DB_PORT=5432
DB_NAME=stocks
DB_USER=postgres
DB_PASSWORD=postgres

# =============================================================================
# PDF Configuration
# =============================================================================

PDF_ROOT=./pdfs
